<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="⚡"
            android:textSize="25sp"
            android:background="@drawable/widget_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Projets électriques"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MT / BT"
                android:textColor="#9FB2CC"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DUPERRET"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Utilisateur actif"
                android:textColor="#9FB2CC"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_initial"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="D"
            android:textColor="#061B3A"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/widget_accent_round" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/action_projects"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/widget_card">

            <TextView
                android:id="@+id/widget_project_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="114"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="25sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Projets"
                android:textColor="#B8C6D9"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_gantt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/widget_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▥" android:textColor="#FFC107" android:textSize="22sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gantt" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_budgets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/widget_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CHF" android:textColor="#FFC107" android:textStyle="bold" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Budgets" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Accès rapides"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/action_open"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="›  Ouvrir le tableau de bord"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="12sp"
        android:background="@drawable/widget_card" />

    <TextView
        android:id="@+id/action_refresh"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="↻  Actualiser le widget"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="12sp"
        android:background="@drawable/widget_card" />

    <TextView
        android:id="@+id/action_config"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="⚙  Changer d’utilisateur"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="12sp"
        android:background="@drawable/widget_card" />

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:text="Mis à jour"
        android:textColor="#8095B2"
        android:textSize="9sp" />

</LinearLayout>
